# Security Analyst Tool - Environment Config
# Copy to .env and add your keys

# OpenRouter API Key (primary)
OPENROUTER_API_KEY=your_openrouter_key_here

# Model ID - pick any OpenRouter-supported model
# Examples: google/gemini-2.0-flash-001, anthropic/claude-3-haiku, openai/gpt-4o-mini
MODEL_ID=google/gemini-2.0-flash-001
